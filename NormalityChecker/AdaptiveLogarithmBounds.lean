private def rowMatches (v : ℕ) : Bool :=
  let (d, r) := clearedRow v
  let q := cellRowList v
  d > 0 &&
    (d : ℚ) * q.1 == (r.1 : ℚ) &&
    (d : ℚ) * q.2.1 == (r.2.1 : ℚ) &&
    (d : ℚ) * q.2.2.1 == (r.2.2.1 : ℚ) &&
    (d : ℚ) * q.2.2.2.1 == (r.2.2.2.1 : ℚ) &&
    (d : ℚ) * q.2.2.2.2 == (r.2.2.2.2 : ℚ)

set_option maxRecDepth 200000 in
private theorem all_rows_match : (List.range 71).all (fun i => rowMatches (i + 1)) = true := by
  decide +kernel

private theorem clearedRow_spec {{v : ℕ}} (hv1 : 1 ≤ v) (hv2 : v ≤ 71) (a u b c : ℚ) :
    ((clearedRow v).1 : ℚ) ≠ 0 ∧
      ((clearedRow v).1 : ℚ) * evalQRow (cellRow v) a u b c =
        evalIRow (clearedRow v).2 a u b c := by
  have hm : rowMatches v = true := by
    have h := List.all_eq_true.mp all_rows_match (v - 1) (List.mem_range.mpr (by omega))
    simpa [show v - 1 + 1 = v by omega] using h
  unfold rowMatches at hm
  simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hm
  obtain ⟨⟨⟨⟨⟨hd, h1⟩, h2⟩, h3⟩, h4⟩, h5⟩ := hm
  rw [← cellRow_eq_list] at h1 h2 h3 h4 h5
  refine ⟨Nat.cast_ne_zero.mpr (by omega), ?_⟩
  unfold evalQRow evalIRow
  calc
    ((clearedRow v).1 : ℚ) *
        ((cellRow v).1 + (cellRow v).2.1 * a + (cellRow v).2.2.1 * u +
          (cellRow v).2.2.2.1 * b + (cellRow v).2.2.2.2 * c)
        = ((clearedRow v).1 : ℚ) * (cellRow v).1 +
          (((clearedRow v).1 : ℚ) * (cellRow v).2.1) * a +
          (((clearedRow v).1 : ℚ) * (cellRow v).2.2.1) * u +
          (((clearedRow v).1 : ℚ) * (cellRow v).2.2.2.1) * b +
          (((clearedRow v).1 : ℚ) * (cellRow v).2.2.2.2) * c := by ring
    _ = _ := by rw [h1, h2, h3, h4, h5]

private theorem evalQRow_eq_zero_iff {v : ℕ} (hv1 : 1 ≤ v) (hv2 : v ≤ 71) (a u b c : ℚ) :
    evalQRow (cellRow v) a u b c = 0 ↔ evalIRow (clearedRow v).2 a u b c = 0 := by
  obtain ⟨hd, heq⟩ := clearedRow_spec hv1 hv2 a u b c
  rw [← heq]
  exact ⟨fun h => by simp [h], fun h => (mul_eq_zero.mp h).resolve_left hd⟩

/-- Common integer denominator for `cellMass 1..71` and `13/30`. -/
def massDen : ℕ := 2812021783838562763275773565600

def massInt (v : ℕ) : ℕ := massDen / ((v * (v + 1)) / 2)

private theorem massInt_spec {v : ℕ} (hv1 : 1 ≤ v) (hv2 : v ≤ 71) :
    (massInt v : ℚ) / (massDen : ℚ) = cellMass v := by
  have hall : (List.range 71).all (fun i =>
      let w := i + 1
      massInt w * (w * (w + 1)) == 2 * massDen) = true := by decide
  have hm := List.all_eq_true.mp hall (v - 1) (List.mem_range.mpr (by omega))
  simp only [show v - 1 + 1 = v by omega, beq_iff_eq] at hm
  unfold cellMass
  have hM : (massDen : ℚ) ≠ 0 := by norm_num [massDen]
  have hv0 : (v : ℚ) * (v + 1 : ℚ) ≠ 0 := by positivity
  rw [div_eq_div_iff hM hv0]
  exact_mod_cast hm

/-- Integer row linear combination helper. -/
def irowAdd (x y : IRow) : IRow :=
  (x.1 + y.1, x.2.1 + y.2.1, x.2.2.1 + y.2.2.1, x.2.2.2.1 + y.2.2.2.1, x.2.2.2.2 + y.2.2.2.2)

def irowScale (s : ℤ) (x : IRow) : IRow :=
  (s * x.1, s * x.2.1, s * x.2.2.1, s * x.2.2.2.1, s * x.2.2.2.2)

def linComb : List ℤ → List IRow → IRow
  | [], _ => (0, 0, 0, 0, 0)
  | _, [] => (0, 0, 0, 0, 0)
  | c :: cs, r :: rs => irowAdd (irowScale c r) (linComb cs rs)

private theorem evalIRow_add (x y : IRow) (a u b c : ℚ) :
    evalIRow (irowAdd x y) a u b c = evalIRow x a u b c + evalIRow y a u b c := by
  unfold evalIRow irowAdd; push_cast; ring

private theorem evalIRow_scale (s : ℤ) (x : IRow) (a u b c : ℚ) :
    evalIRow (irowScale s x) a u b c = (s : ℚ) * evalIRow x a u b c := by
  unfold evalIRow irowScale; push_cast; ring

private theorem evalIRow_linComb_zero (cs : List ℤ) (rs : List IRow) (a u b c : ℚ)
    (h : ∀ r ∈ rs, evalIRow r a u b c = 0) :
    evalIRow (linComb cs rs) a u b c = 0 := by
  induction cs generalizing rs with
  | nil => simp [linComb, evalIRow]
  | cons k ks ih =>
    cases rs with
    | nil => simp [linComb, evalIRow]
    | cons r rs =>
      rw [linComb, evalIRow_add, evalIRow_scale, h r (List.mem_cons_self ..), mul_zero, zero_add]
      exact ih rs (fun r' hr' => h r' (List.mem_cons_of_mem r hr'))

/-- Pure-integer branch-and-bound certificate tree. -/
inductive Cert where
  | pruned : Cert
  | leaf (a u b c : ℤ) (wits : List (ℤ × List ℤ)) : Cert
  | stepConst (v : ℕ) (scale : ℤ) (cs : List ℤ) (kval : ℤ) (next : Cert) : Cert
  | branch (v : ℕ) (zeroBranch : Cert) (nonzeroBranch : Cert) : Cert

def checkLeaf (a u b c : ℤ) (wits : List (ℤ × List ℤ)) (eqs : List IRow) : Bool :=
  match wits with
  | [(s0, w0), (s1, w1), (s2, w2), (s3, w3)] =>
    s0 > 0 && s1 > 0 && s2 > 0 && s3 > 0 &&
    linComb w0 eqs == (-s0 * a, s0, 0, 0, 0) &&
    linComb w1 eqs == (-s1 * u, 0, s1, 0, 0) &&
    linComb w2 eqs == (-s2 * b, 0, 0, s2, 0) &&
    linComb w3 eqs == (-s3 * c, 0, 0, 0, s3)
  | _ => false

def checkCert (cert : Cert) (minV : ℕ) (eqs : List IRow) (spent : ℕ) : Bool :=
  match cert with
  | .pruned => 30 * spent ≥ 13 * massDen
  | .leaf a u b c wits =>
    ((a == 0 && u == 0 && b == 0 && c == -5) ||
     (a == 0 && u == 0 && b == 0 && c == -2)) &&
    checkLeaf a u b c wits eqs
  | .stepConst v scale cs kval next =>
    minV ≤ v && v ≤ 71 && scale > 0 && kval ≠ 0 &&
    irowAdd (irowScale scale (clearedRow v).2) (irowScale (-1) (linComb cs eqs)) == (kval, 0, 0, 0, 0) &&
    checkCert next (v + 1) eqs (spent + massInt v)
  | .branch v zBranch nzBranch =>
    minV ≤ v && v ≤ 71 &&
    checkCert zBranch (v + 1) (eqs ++ [(clearedRow v).2]) spent &&
    checkCert nzBranch (v + 1) eqs (spent + massInt v)

private theorem checkLeaf_sound {a₀ u₀ b₀ c₀ : ℤ} {wits : List (ℤ × List ℤ)}
    {eqs : List IRow} {a u b c : ℚ}
    (hchk : checkLeaf a₀ u₀ b₀ c₀ wits eqs = true)
    (heqs : ∀ r ∈ eqs, evalIRow r a u b c = 0) :
    a = (a₀ : ℚ) ∧ u = (u₀ : ℚ) ∧ b = (b₀ : ℚ) ∧ c = (c₀ : ℚ) := by
  rcases wits with _ | ⟨⟨s0, w0⟩, _ | ⟨⟨s1, w1⟩, _ | ⟨⟨s2, w2⟩, _ | ⟨⟨s3, w3⟩, _ | _⟩⟩⟩⟩
  all_goals simp [checkLeaf] at hchk
  obtain ⟨⟨⟨⟨⟨⟨⟨hs0, hs1⟩, hs2⟩, hs3⟩, hw0⟩, hw1⟩, hw2⟩, hw3⟩ := hchk
  have e0 := evalIRow_linComb_zero w0 eqs a u b c heqs
  have e1 := evalIRow_linComb_zero w1 eqs a u b c heqs
  have e2 := evalIRow_linComb_zero w2 eqs a u b c heqs
  have e3 := evalIRow_linComb_zero w3 eqs a u b c heqs
  rw [hw0] at e0; rw [hw1] at e1; rw [hw2] at e2; rw [hw3] at e3
  unfold evalIRow at e0 e1 e2 e3
  push_cast at e0 e1 e2 e3
  have q0 : (s0 : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (by omega)
  have q1 : (s1 : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (by omega)
  have q2 : (s2 : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (by omega)
  have q3 : (s3 : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (by omega)
  refine ⟨?_, ?_, ?_, ?_⟩
  · apply mul_left_cancel₀ q0; linarith
  · apply mul_left_cancel₀ q1; linarith
  · apply mul_left_cancel₀ q2; linarith
  · apply mul_left_cancel₀ q3; linarith

private def activeIntSum (lo : ℕ) (a u b c : ℚ) : ℕ :=
  ∑ v ∈ Icc lo 71, if evalQRow (cellRow v) a u b c ≠ 0 then massInt v else 0

private theorem activeIntSum_split {lo v : ℕ} (hlo : lo ≤ v) (hv : v ≤ 71) (a u b c : ℚ) :
    (if evalQRow (cellRow v) a u b c ≠ 0 then massInt v else 0) + activeIntSum (v + 1) a u b c ≤
      activeIntSum lo a u b c := by
  unfold activeIntSum
  have hsub : insert v (Icc (v + 1) 71) ⊆ Icc lo 71 := by
    intro x hx
    simp only [mem_insert, mem_Icc] at hx ⊢
    rcases hx with rfl | ⟨h1, h2⟩ <;> omega
  have hnot : v ∉ Icc (v + 1) 71 := by simp
  have h1 := sum_le_sum_of_subset hsub (f := fun w => if evalQRow (cellRow w) a u b c ≠ 0 then massInt w else 0)
  rw [sum_insert hnot] at h1
  exact h1

private theorem checkCert_sound (cert : Cert) :
    ∀ (minV : ℕ) (eqs : List IRow) (spent : ℕ) (a u b c : ℚ),
      1 ≤ minV →
      checkCert cert minV eqs spent = true →
      (∀ r ∈ eqs, evalIRow r a u b c = 0) →
      30 * (spent + activeIntSum minV a u b c) ≥ 13 * massDen ∨
        (a = 0 ∧ u = 0 ∧ b = 0 ∧ c = -5) ∨
        (a = 0 ∧ u = 0 ∧ b = 0 ∧ c = -2) := by
  induction cert with
  | pruned =>
    intro minV eqs spent a u b c _ hchk _
    left
    unfold checkCert at hchk
    simp only [decide_eq_true_eq] at hchk
    omega
  | leaf a₀ u₀ b₀ c₀ wits =>
    intro minV eqs spent a u b c _ hchk heqs
    unfold checkCert at hchk
    simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq] at hchk
    obtain ⟨hpt, hleaf⟩ := hchk
    obtain ⟨ha, hu, hb, hc⟩ := checkLeaf_sound hleaf heqs
    rcases hpt with ⟨⟨⟨rfl, rfl⟩, rfl⟩, rfl⟩ | ⟨⟨⟨rfl, rfl⟩, rfl⟩, rfl⟩
    · right; left; exact ⟨by simpa using ha, by simpa using hu, by simpa using hb, by simpa using hc⟩
    · right; right; exact ⟨by simpa using ha, by simpa using hu, by simpa using hb, by simpa using hc⟩
  | stepConst v scale cs kval next ih =>
    intro minV eqs spent a u b c hmin hchk heqs
    unfold checkCert at hchk
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hchk
    obtain ⟨⟨⟨⟨⟨hlo, hv71⟩, hsc⟩, hk⟩, hrow⟩, hnext⟩ := hchk
    have hnz : evalQRow (cellRow v) a u b c ≠ 0 := by
      intro hz
      have hiz : evalIRow (clearedRow v).2 a u b c = 0 :=
        (evalQRow_eq_zero_iff (by omega) hv71 a u b c).mp hz
      have hlc := evalIRow_linComb_zero cs eqs a u b c heqs
      have heval : evalIRow (irowAdd (irowScale scale (clearedRow v).2) (irowScale (-1) (linComb cs eqs))) a u b c = 0 := by
        rw [evalIRow_add, evalIRow_scale, evalIRow_scale, hiz, hlc]; ring
      rw [hrow] at heval
      unfold evalIRow at heval
      simp only [Int.cast_zero, zero_mul, add_zero] at heval
      exact hk (Int.cast_eq_zero.mp heval)
    have hstep := activeIntSum_split hlo hv71 a u b c
    rw [ite_eq_left hnz] at hstep
    rcases ih (v + 1) eqs (spent + massInt v) a u b c (by omega) hnext heqs with hmass | h1 | h2
    · left; omega
    · right; left; exact h1
    · right; right; exact h2
  | branch v zBranch nzBranch ihz ihnz =>
    intro minV eqs spent a u b c hmin hchk heqs
    unfold checkCert at hchk
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hchk
    obtain ⟨⟨⟨hlo, hv71⟩, hz⟩, hnz_chk⟩ := hchk
    have hstep := activeIntSum_split hlo hv71 a u b c
    by_cases hvz : evalQRow (cellRow v) a u b c = 0
    · have hiz : evalIRow (clearedRow v).2 a u b c = 0 :=
        (evalQRow_eq_zero_iff (by omega) hv71 a u b c).mp hvz
      have heqs' : ∀ r ∈ eqs ++ [(clearedRow v).2], evalIRow r a u b c = 0 := by
        intro r hr
        rcases List.mem_append.mp hr with h1 | h2
        · exact heqs r h1
        · simp only [List.mem_singleton] at h2; subst h2; exact hiz
      rcases ihz (v + 1) (eqs ++ [(clearedRow v).2]) spent a u b c (by omega) hz heqs' with hmass | h1 | h2
      · left; rw [ite_eq_right (not_not.mpr hvz)] at hstep; omega
      · right; left; exact h1
      · right; right; exact h2
    · rcases ihnz (v + 1) eqs (spent + massInt v) a u b c (by omega) hnz_chk heqs with hmass | h1 | h2
      · left; rw [ite_eq_left hvz] at hstep; omega
      · right; left; exact h1
      · right; right; exact h2


private theorem mainCert_valid : checkCert mainCert 1 [] 0 = true := by
  decide

private theorem activeMass71_eq_intDiv (a u b c : ℚ) :
    activeMass71 a u b c = (activeIntSum 1 a u b c : ℚ) / (massDen : ℚ) := by
  unfold activeIntSum activeMass71
  rw [Nat.cast_sum, sum_div]
  apply sum_congr rfl
  intro v hv
  have hv1 := (mem_Icc.mp hv).1
  have hv2 := (mem_Icc.mp hv).2
  split_ifs
  · exact (massInt_spec hv1 hv2).symm
  · simp

/-- Global optimality and uniform finite-cell bound over all of `ℚ⁴`:
every `(a, u, b, c) ∈ ℚ⁴` either has active prime-band mass at least `13/30` already on
cells `1 ≤ v ≤ 71`, or equals `(0, 0, 0, -5)` (the unique `5/12` minimizer), or equals
`(0, 0, 0, -2)` (the unique `13/30` runner-up). -/
theorem global_cell_mass_bound (a u b c : ℚ) :
    (13 / 30 : ℚ) ≤ activeMass71 a u b c ∨
      (a = 0 ∧ u = 0 ∧ b = 0 ∧ c = -5) ∨
      (a = 0 ∧ u = 0 ∧ b = 0 ∧ c = -2) := by
  rcases checkCert_sound mainCert 1 [] 0 a u b c (by decide) mainCert_valid (by simp) with h | h1 | h2
  · left
    rw [activeMass71_eq_intDiv]
    have hM : (0 : ℚ) < (massDen : ℚ) := by norm_num [massDen]
    rw [div_le_div_iff₀ (by norm_num) hM]
    have hq : (13 * massDen : ℚ) ≤ (30 * activeIntSum 1 a u b c : ℚ) := by
      exact_mod_cast (show 13 * massDen ≤ 30 * activeIntSum 1 a u b c by omega)
    linarith
  · right; left; exact h1
  · right; right; exact h2

private def activeIntAtInt (a u b c : ℤ) : ℕ :=
  (List.range 71).foldl
    (fun acc i =>
      let v := i + 1
      let r := (clearedRow v).2
      let val : ℤ := r.1 + r.2.1 * a + r.2.2.1 * u + r.2.2.2.1 * b + r.2.2.2.2 * c
      acc + if val ≠ 0 then massInt v else 0) 0

private theorem activeIntSum_at_int (a u b c : ℤ) :
    activeIntSum 1 (a : ℚ) (u : ℚ) (b : ℚ) (c : ℚ) = activeIntAtInt a u b c := by
  unfold activeIntSum activeIntAtInt
  have hfold : ∀ n (g : ℕ → ℕ),
      (List.range n).foldl (fun acc i => acc + g i) 0 = ∑ i ∈ range n, g i := by
    intro n g
    induction n with
    | zero => simp
    | succ n ih =>
      rw [List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil, ih, sum_range_succ]
  rw [hfold]
  refine Finset.sum_nbij (fun v => v - 1) ?_ ?_ ?_ ?_
  · intro v hv; simp only [mem_Icc, mem_range] at hv ⊢; omega
  · intro v₁ hv₁ v₂ hv₂ h; simp only [mem_coe, mem_Icc] at hv₁ hv₂; dsimp only at h; omega
  · intro i hi; simp only [mem_coe, mem_range] at hi; exact ⟨i + 1, mem_Icc.mpr ⟨by omega, by omega⟩, by dsimp only; omega⟩
  · intro v hv
    have hv1 := (mem_Icc.mp hv).1
    have hv2 := (mem_Icc.mp hv).2
    have hvv : v - 1 + 1 = v := by omega
    rw [hvv]
    have hiff : evalQRow (cellRow v) (a : ℚ) (u : ℚ) (b : ℚ) (c : ℚ) ≠ 0 ↔
        ((clearedRow v).2.1 + (clearedRow v).2.2.1 * a + (clearedRow v).2.2.2.1 * u +
          (clearedRow v).2.2.2.2.1 * b + (clearedRow v).2.2.2.2.2 * c) ≠ 0 := by
      rw [ne_eq, evalQRow_eq_zero_iff hv1 hv2]
      unfold evalIRow
      exact not_congr (by exact_mod_cast (Int.cast_eq_zero (α := ℚ)))
    simp only [hiff]

/-- Exact active mass on `1 ≤ v ≤ 71` for the `5/12` minimizer `(0, 0, 0, -5)` is `7/18`. -/
theorem minimizer_mass71 : activeMass71 0 0 0 (-5) = 7 / 18 := by
  have hcalc : 18 * activeIntAtInt 0 0 0 (-5) = 7 * massDen := by decide
  have hq : activeMass71 ((0 : ℤ) : ℚ) ((0 : ℤ) : ℚ) ((0 : ℤ) : ℚ) ((-5 : ℤ) : ℚ) = 7 / 18 := by
    rw [activeMass71_eq_intDiv, activeIntSum_at_int]
    have hM : (massDen : ℚ) ≠ 0 := by norm_num [massDen]
    rw [div_eq_div_iff hM (by norm_num)]
    exact_mod_cast hcalc
  simpa using hq

/-- Exact active mass on `1 ≤ v ≤ 71` for the `13/30` runner-up `(0, 0, 0, -2)` is `73/180`. -/
theorem runnerup_mass71 : activeMass71 0 0 0 (-2) = 73 / 180 := by
  have hcalc : 180 * activeIntAtInt 0 0 0 (-2) = 73 * massDen := by decide
  have hq : activeMass71 ((0 : ℤ) : ℚ) ((0 : ℤ) : ℚ) ((0 : ℤ) : ℚ) ((-2 : ℤ) : ℚ) = 73 / 180 := by
    rw [activeMass71_eq_intDiv, activeIntSum_at_int]
    have hM : (massDen : ℚ) ≠ 0 := by norm_num [massDen]
    rw [div_eq_div_iff hM (by norm_num)]
    exact_mod_cast hcalc
  simpa using hq


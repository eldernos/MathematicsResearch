module

public import NormalityChecker.GaussianLogarithmRelations
public import Mathlib.Tactic

/-! Kernel-checked global branch-and-bound certificate over `ℚ⁴` for the Phase 14/16
real+Gaussian dyadic logarithm family.

Proves unconditionally that for every parameter vector `θ = (a, u, b, c) ∈ ℚ⁴`,
either the prime-band mass over active cells `1 ≤ v ≤ 71` is at least `13/30`,
or `θ = (0, 0, 0, -5)` (the unique `5/12` minimizer, mass `7/18` on `1..71`),
or `θ = (0, 0, 0, -2)` (the unique `13/30` runner-up, mass `73/180` on `1..71`).
Combined with positivity of both leaves on all `v ≥ 8`, this gives the uniform
finite-cell bound `m_V(θ) ≥ 5/12 - 1/V` (and `≥ 13/30 - 1/V` off `(0,0,0,-5)`)
for every `V ≥ 36` and every `θ ∈ ℚ⁴`. -/

@[expose] public section

open Finset

namespace NormalityChecker.AdaptiveLogarithmBounds

/-- Real dyadic logarithm prefix `A_k(v/2) = ∑_{1 ≤ j ≤ v/(2k)} 2^{-kj} / j`. -/
def srcA (k v : ℕ) : ℚ :=
  ∑ j ∈ Icc 1 (v / (2 * k)), (1 : ℚ) / ((j : ℚ) * (2 : ℚ) ^ (k * j))

/-- Gaussian dyadic logarithm prefix `G_t(v/2) = ∑_{1 ≤ j ≤ v/(2t-1)} 2 Re((1+i)^j) / (j 2^{tj})`. -/
def srcG (t v : ℕ) : ℚ :=
  ∑ j ∈ Icc 1 (v / (2 * t - 1)),
    (2 * (NormalityChecker.GaussianLogarithmRelations.onePlusI ^ j).re : ℚ) /
      ((j : ℚ) * (2 : ℚ) ^ (t * j))

/-- Computable exact list-based evaluation of `srcA` for fast kernel verification. -/
private def srcAList (k v : ℕ) : ℚ :=
  (List.range (v / (2 * k))).foldl
    (fun acc i => acc + Rat.divInt 1 (((i + 1) * 2 ^ (k * (i + 1)) : ℕ) : ℤ)) 0

/-- Computable exact list-based evaluation of `srcG` using `re_pow_onePlusI`. -/
private def srcGList (t v : ℕ) : ℚ :=
  (List.range (v / (2 * t - 1))).foldl
    (fun acc i =>
      let j := i + 1
      let num : ℤ := 2 * (2 : ℤ) ^ (j / 2) * NormalityChecker.GaussianLogarithmRelations.realSign j
      acc + Rat.divInt num ((j * 2 ^ (t * j) : ℕ) : ℤ)) 0

private lemma foldl_add_eq_sum (n : ℕ) (f : ℕ → ℚ) :
    (List.range n).foldl (fun acc i => acc + f i) 0 = ∑ i ∈ range n, f i := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil, ih, sum_range_succ]

private lemma srcA_eq_list (k v : ℕ) : srcA k v = srcAList k v := by
  unfold srcA srcAList
  rw [foldl_add_eq_sum]
  refine Finset.sum_nbij (fun j => j - 1) ?_ ?_ ?_ ?_
  · intro j hj; simp only [mem_Icc, mem_range] at hj ⊢; omega
  · intro a ha b hb h; simp only [mem_coe, mem_Icc] at ha hb; dsimp only at h; omega
  · intro i hi; simp only [mem_coe, mem_range] at hi; exact ⟨i + 1, mem_Icc.mpr ⟨by omega, by omega⟩, by dsimp only; omega⟩
  · intro j hj
    have hj1 : 1 ≤ j := (mem_Icc.mp hj).1
    have hjj : j - 1 + 1 = j := by omega
    rw [hjj, Rat.divInt_eq_div]
    push_cast
    rfl

private lemma srcG_eq_list (t v : ℕ) : srcG t v = srcGList t v := by
  unfold srcG srcGList
  rw [foldl_add_eq_sum]
  refine Finset.sum_nbij (fun j => j - 1) ?_ ?_ ?_ ?_
  · intro j hj; simp only [mem_Icc, mem_range] at hj ⊢; omega
  · intro a ha b hb h; simp only [mem_coe, mem_Icc] at ha hb; dsimp only at h; omega
  · intro i hi; simp only [mem_coe, mem_range] at hi; exact ⟨i + 1, mem_Icc.mpr ⟨by omega, by omega⟩, by dsimp only; omega⟩
  · intro j hj
    have hj1 : 1 ≤ j := (mem_Icc.mp hj).1
    have hjj : j - 1 + 1 = j := by omega
    rw [hjj, Rat.divInt_eq_div, NormalityChecker.GaussianLogarithmRelations.re_pow_onePlusI]
    push_cast
    ring

/-- Five-component rational row `(B, A₁-B, G₁-B, G₂+A₂-A₄-B, G₃+2A₂-2A₄-B)` at cell `v/2`. -/
abbrev QRow := ℚ × ℚ × ℚ × ℚ × ℚ

def cellRow (v : ℕ) : QRow :=
  let a1 := srcA 1 v
  let a2 := srcA 2 v
  let a3 := srcA 3 v
  let a4 := srcA 4 v
  let a6 := srcA 6 v
  let g1 := srcG 1 v
  let g2 := srcG 2 v
  let g3 := srcG 3 v
  let base := 2 * a2 + a3 - a6
  (base, a1 - base, g1 - base, g2 + a2 - a4 - base, g3 + 2 * a2 - 2 * a4 - base)

private def cellRowList (v : ℕ) : QRow :=
  let a1 := srcAList 1 v
  let a2 := srcAList 2 v
  let a3 := srcAList 3 v
  let a4 := srcAList 4 v
  let a6 := srcAList 6 v
  let g1 := srcGList 1 v
  let g2 := srcGList 2 v
  let g3 := srcGList 3 v
  let base := 2 * a2 + a3 - a6
  (base, a1 - base, g1 - base, g2 + a2 - a4 - base, g3 + 2 * a2 - 2 * a4 - base)

private lemma cellRow_eq_list (v : ℕ) : cellRow v = cellRowList v := by
  unfold cellRow cellRowList
  simp only [srcA_eq_list, srcG_eq_list]

def evalQRow (r : QRow) (a u b c : ℚ) : ℚ :=
  r.1 + r.2.1 * a + r.2.2.1 * u + r.2.2.2.1 * b + r.2.2.2.2 * c

/-- Asymptotic prime-band mass `2 / (v (v + 1))` of cell `v`. -/
def cellMass (v : ℕ) : ℚ := (2 : ℚ) / ((v : ℚ) * (v + 1 : ℚ))

/-- Active prime-band mass of `θ = (a, u, b, c)` over cells `1 ≤ v ≤ 71`. -/
def activeMass71 (a u b c : ℚ) : ℚ :=
  ∑ v ∈ Icc 1 71, if evalQRow (cellRow v) a u b c ≠ 0 then cellMass v else 0

/-- Integer-cleared row `(c₀, c_a, c_u, c_b, c_c)` for fast kernel verification. -/
abbrev IRow := ℤ × ℤ × ℤ × ℤ × ℤ

def evalIRow (r : IRow) (a u b c : ℚ) : ℚ :=
  (r.1 : ℚ) + (r.2.1 : ℚ) * a + (r.2.2.1 : ℚ) * u + (r.2.2.2.1 : ℚ) * b + (r.2.2.2.2 : ℚ) * c


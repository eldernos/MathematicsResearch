module

public import NormalityChecker.UnsignedPhase

/-! Periodicity and finite exponent bounds for iterated cofactor differences. -/
@[expose] public section
noncomputable section
open Finset
namespace NormalityChecker.LocalizedSupport.Unsigned

variable {p : ℕ} [hp : Fact p.Prime]

/-- The numerator weight depends only on the residue of its argument modulo D. -/
def ResidueWeight (D : ℕ) (A : ℕ → ℤ_[p]) : Prop :=
  ∀ ⦃m n : ℕ⦄, m ≡ n [MOD D] → A m = A n

lemma unsigned_residue {w : ℤ_[p]} (fixed : w^p = w) (unit : ‖w‖ = 1) :
    ∃ D > 0, ResidueWeight D (fun m => w^m) := by
  have wn : w ≠ 0 := by rintro rfl; simp at unit
  have hpow : w^(p-1) = 1 := by
    apply mul_right_cancel₀ wn
    rw [one_mul, ← pow_succ, Nat.sub_add_cancel hp.out.one_le,fixed]
  have fin : IsOfFinOrder w := isOfFinOrder_iff_pow_eq_one.mpr ⟨p-1,by have := hp.out.two_le; omega,hpow⟩
  exact ⟨orderOf w,fin.orderOf_pos, fun {_ _} h => fin.pow_eq_pow_iff_modEq.mpr h⟩

theorem difference_residue {Q D : ℕ} (pos : 0 < Q) {A : ℕ → ℤ_[p]} (period : ResidueWeight D A) :
    ResidueWeight (Q*D) (difference Q A) := by
  intro m n eqn
  have same := period (eqn.of_dvd (dvd_mul_left D Q))
  have dvd := eqn.dvd_iff (dvd_mul_right Q D)
  by_cases hm : Q ∣ m
  · obtain ⟨u,rfl⟩ := hm
    obtain ⟨v,rfl⟩ := dvd.mp (dvd_mul_right ..)
    simp [difference,shiftedWeight,pos.ne',same,period (eqn.mul_left_cancel' pos.ne')]
  · have hn : ¬ Q ∣ n := fun d => hm (dvd.mpr d)
    simp [difference,shiftedWeight,hm,hn,same]

lemma finite_range_of_residue {D : ℕ} (pos : 0 < D) {A : ℕ → ℤ_[p]} (period : ResidueWeight D A) :
    (Set.range A).Finite := by
  refine ((range D).finite_toSet.image A).subset ?_
  rintro _ ⟨m,rfl⟩
  exact ⟨m % D, mem_range.mpr (Nat.mod_lt m pos), period (Nat.mod_modEq ..)⟩

/-- Powers can have a preperiod when q shares a prime with D. Every positive
multiple of the resulting stride can be used as a return time. -/
lemma cofactor_stride (q : ℕ) {D : ℕ} (pos : 0 < D) :
    ∃ L h : ℕ, 0 < h ∧ ∀ n : ℕ, q^(L+h*n) ≡ q^L [MOD D] := by
  let f (j : ℕ) := q^j % D
  obtain ⟨L,M,lt,eqn⟩ := (range D).finite_toSet.exists_lt_map_eq_of_forall_mem
    (f:=f) (fun j => mem_range.mpr (Nat.mod_lt _ pos))
  let h := M-L
  have first : q^(L+h) ≡ q^L [MOD D] := by
    rw [show L+h = M by dsimp [h]; omega]
    exact eqn.symm
  refine ⟨L,h,by dsimp [h]; omega,?_⟩
  intro n
  induction n with
  | zero => simp [Nat.ModEq]
  | succ n ih =>
    rw [Nat.mul_succ, ← Nat.add_assoc,pow_add]
    exact (ih.mul_right _).trans (by rwa [← pow_add])

/-- One round of differencing bounds the exponent of q by L+a-1. -/
lemma difference_tail {D L a q : ℕ} (hq : 0 < q) {A : ℕ → ℤ_[p]}
    (period : ResidueWeight D A) (rep : q^(L+a) ≡ q^L [MOD D]) {m : ℕ}
    (high : q^(L+a) ∣ m) : difference (q^a) A m = 0 := by
  obtain ⟨u,rfl⟩ := high
  have eqn : q^(L+a)*u = q^a * (q^L*u) := by rw [pow_add]; ring
  have same := period (rep.mul_right u)
  rw [difference,shiftedWeight,eqn,ite_eq_left (dvd_mul_right ..), Nat.mul_div_cancel_left _ (pow_pos hq a),
    ← eqn,same,sub_self]

/-- For an unsigned moment, an equality between two powers of the actual
Teichmüller factor suffices to truncate one cofactor exponent, even when the
chosen stride is shorter than a period for all residues modulo p−1. -/
theorem phaseMoment_truncated_difference {S : Finset ℕ} (out : p ∉ S) {q L a s : ℕ}
    (hq : q.Prime) (qS : q ∈ S) (w : ℤ_[p]) (hs : 0 < s) (t : ℝ)
    (cycle : w^(q^(L+a)) = w^(q^L)) :
    phaseMoment S w s t - ((q^a : ℕ) : ℤ_[p]).inv^s * phaseMoment S w s (t/(q^a : ℕ)) =
      moment S (fun m => if q^(L+a) ∣ m then 0 else difference (q^a) (w^·) m) s t := by
  have mem := prime_power_mem hq qS a
  rw [← moment_unsigned, ← moment_unsigned, ← moment_difference out mem _ hs]
  congr 1
  funext m
  split_ifs with high
  · obtain ⟨u,rfl⟩ := high
    have eqn : q^(L+a)*u = q^a*(q^L*u) := by rw [pow_add]; ring
    have same := ThresholdDifferences.stabilized_weight w cycle (le_refl L) u
    rw [difference,shiftedWeight,eqn,ite_eq_left (dvd_mul_right ..),
      Nat.mul_div_cancel_left _ (pow_pos hq.pos a),← eqn,same,sub_self]
  · rfl

/-- All nonzero coefficients are on a finite union of dilates of the
semigroup generated by the remaining unbounded primes. -/
def SupportedOn (S : Finset ℕ) (A : ℕ → ℤ_[p]) (C T : Finset ℕ) : Prop :=
  ∀ m ∈ Nat.factoredNumbers S, A m ≠ 0 → ∃ c ∈ C, ∃ v ∈ Nat.factoredNumbers T, m = c*v

theorem difference_support {S C T : Finset ℕ} {A : ℕ → ℤ_[p]} {D L a q : ℕ}
    (hq : q.Prime) (out : q ∉ T) (period : ResidueWeight D A)
    (rep : q^(L+a) ≡ q^L [MOD D]) (old : SupportedOn S A C (insert q T)) :
    SupportedOn S (difference (q^a) A)
      ((C ×ˢ range (L+a)).image (fun u => u.1*q^u.2)) T := by
  intro m hm nz
  have cover : ∃ c ∈ C, ∃ v ∈ Nat.factoredNumbers (insert q T), m = c*v := by
    by_cases am : A m = 0
    · by_cases d : q^a ∣ m
      · obtain ⟨v,rfl⟩ := d
        have av : A v ≠ 0 := by
          intro zero
          exact nz (by simp [difference,shiftedWeight,am,zero,hq.ne_zero])
        obtain ⟨c,hc,k,hk,eqn⟩ := old v (Nat.mem_factoredNumbers_of_dvd hm (dvd_mul_left ..)) av
        exact ⟨c,hc,q^a*k, Nat.mul_mem_factoredNumbers
          (by simpa using Nat.pow_mul_mem_factoredNumbers hq a (s:=T) (n:=1) (Nat.mem_factoredNumbers'.mpr (fun q prime d => (prime.not_dvd_one d).elim))) hk,
          by rw [eqn]; ring⟩
      · exact (nz (by simp [difference,am,shiftedWeight,d])).elim
    · exact old m hm am
  obtain ⟨c,hc,v,hv,rfl⟩ := cover
  let e := Nat.equivProdNatFactoredNumbers hq out
  let u := e.symm ⟨v,hv⟩
  have expand : q^u.1*u.2.val = v := congrArg Subtype.val (e.apply_symm_apply ⟨v,hv⟩)
  have low : u.1 < L+a := by
    by_contra! high
    apply nz
    apply difference_tail hq.pos period rep
    rw [← expand]
    exact dvd_mul_of_dvd_right (dvd_mul_of_dvd_left (pow_dvd_pow q high) _) _
  exact ⟨c*q^u.1,mem_image.mpr ⟨(c,u.1),mem_product.mpr ⟨hc,mem_range.mpr low⟩,rfl⟩,
    u.2.val,u.2.property,by rw [← expand,mul_assoc]⟩

lemma difference_bare {A : ℕ → ℤ_[p]} {q r a : ℕ} (hq : q.Prime) (hr : r.Prime) (ne : q ≠ r)
    (ha : 0 < a) (l : ℕ) : difference (q^a) A (r^l) = A (r^l) := by
  have nd : ¬q^a ∣ r^l := fun d =>
    (hq.coprime_iff_not_dvd.mp ((Nat.coprime_primes hq hr).mpr ne))
      (hq.dvd_of_dvd_pow ((dvd_pow_self q ha.ne').trans d))
  simp [difference,shiftedWeight,nd]

end NormalityChecker.LocalizedSupport.Unsigned

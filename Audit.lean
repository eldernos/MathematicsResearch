import NormalityChecker
import Lean.Util.CollectAxioms

open Lean in
run_cmd do
  let permitted := [``propext, ``Classical.choice, ``Quot.sound]
  let results := [
    ``NormalityChecker.normalIn_iff_uniform_approx,
    ``NormalityChecker.not_normal_of_frequent_excess,
    ``NormalityChecker.logTwo_tail_bounds,
    ``NormalityChecker.logTwo_normal_iff,
    ``NormalityChecker.logPrefix_run_bound,
    ``NormalityChecker.pair_divisibility,
    ``NormalityChecker.resonant_zero_block,
    ``NormalityChecker.components_not_binary_normal,
    ``NormalityChecker.hasSum_components_logTwo,
    ``NormalityChecker.ordered_phase_ne_zero,
    ``NormalityChecker.logDen_ten,
    ``NormalityChecker.logDen_dvd_lcm,
    ``NormalityChecker.prime_cancellation,
    ``NormalityChecker.logLoss_nonneg,
    ``NormalityChecker.logLoss_le,
    ``NormalityChecker.logLoss_isBigO,
    ``NormalityChecker.tendsto_logDen_div,
    ``NormalityChecker.reciprocal_logDen,
    ``NormalityChecker.offset_zero_block,
    ``NormalityChecker.offset_components_not_binary_normal,
    ``NormalityChecker.two_component_normal_necessary,
    ``NormalityChecker.stride_lift,
    ``NormalityChecker.half_stride_linearization,
    ``NormalityChecker.orderOf_two_three_pow,
    ``NormalityChecker.incomplete_orbit_bound,
    ``NormalityChecker.incomplete_orbit_interval,
    ``NormalityChecker.Weyl.equidistributed_of_weyl,
    ``NormalityChecker.logPrefix_steps,
    ``NormalityChecker.logPrefix_steps_bounds,
    ``NormalityChecker.logPrefix_lag_character_bound,
    ``NormalityChecker.binary_normal_of_odd_fourier,
    ``NormalityChecker.logTwo_normal_of_odd_prefix_fourier,
    ``NormalityChecker.Polylog.shifted_eq,
    ``NormalityChecker.Polylog.denominator_dvd,
    ``NormalityChecker.Polylog.denominator_zero_order,
    ``NormalityChecker.Polylog.prime_cancellation,
    ``NormalityChecker.Polylog.prime_cancellation_of_dvd_base,
    ``NormalityChecker.Polylog.loss_nonneg,
    ``NormalityChecker.Polylog.loss_le,
    ``NormalityChecker.Polylog.loss_isBigO,
    ``NormalityChecker.component_orbit_approx,
    ``NormalityChecker.finite_orbit_approx,
    ``NormalityChecker.mean_zero_of_cells,
    ``NormalityChecker.fixed_multiplier_orbit,
    ``NormalityChecker.cell_orbit_approx,
    ``NormalityChecker.cell_cancellation,
    ``NormalityChecker.binary_normal_of_dilated_fourier,
    ``NormalityChecker.not_normal_of_concentration,
    ``NormalityChecker.not_normal_of_grid_cell,
    ``NormalityChecker.finite_normal_iff,
    ``NormalityChecker.binaryNormalTest_correct,
    ``NormalityChecker.two_component_normal_iff,
    ``NormalityChecker.three_component_resonance,
    ``NormalityChecker.component_binary_normal,
    ``NormalityChecker.ordered_sum_binary_normal,
    ``NormalityChecker.not_normal_of_prefix_hits,
    ``NormalityChecker.geometric_cells_limsup,
    ``NormalityChecker.odd_radix_lift,
    ``NormalityChecker.radix_pair_tail,
    ``NormalityChecker.radix_pair_zero_limsup,
    ``NormalityChecker.radix_pair_not_normal,
    ``NormalityChecker.radix_pair_irrational,
    ``NormalityChecker.oddSquareDivisor_spec,
    ``NormalityChecker.all_base_resonance,
    ``NormalityChecker.severe_resonance,
    ``NormalityChecker.binary_zero_block_limsup]
  for decl in results do
    let axioms ← collectAxioms decl
    let unexpected := axioms.filter fun a => !permitted.contains a
    unless unexpected.isEmpty do
      throwError "{decl} depends on unexpected axioms {unexpected}"
    logInfo m!"{decl}: {axioms}"
